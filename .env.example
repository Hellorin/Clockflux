# Google OAuth Client ID for "Sign in with Google" (Google Identity Services).
# This is a public identifier, not a secret — safe to embed in the front-end
# bundle. Create one at https://console.cloud.google.com/apis/credentials
# and add http://localhost:5173 (and your production origin) as an
# authorized JavaScript origin.
VITE_GOOGLE_CLIENT_ID=

# Base URL of the Timeforge API (used for e.g. verifying Google sign-in
# server-side at /api/v1/auth/google).
VITE_API_URL=http://localhost:8080

# Feature flag for "Sign in with Google" and everything behind it. The
# backend auth flow isn't production-ready yet, so this is off by default —
# set to 'true' to enable it locally.
VITE_ENABLE_AUTH=false

# Master switch for paid-only features. Off by default until paid features
# actually ship. Login is shown only when this AND VITE_ENABLE_AUTH are both
# 'true' — signing in exists solely to unlock paid features, so there's no
# point showing it while none are enabled.
VITE_ENABLE_PAID_FEATURES=false

# Base URL of clockflux-account-front (the pricing/checkout app), used
# for the Settings page's "Upgrade to Pro" link. Defaults to the production
# account site if unset; override to point at a local instance, e.g.
# http://localhost:5174.
VITE_ACCOUNT_URL=https://account.clockflux.app
